{
  "info": {
    "name": "Sistema de Biblioteca - JWT API (Unipar)",
    "description": "Coleção completa para testes da API de Gestão de Biblioteca com JWT e Refresh Token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autenticação (Auth)",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@biblioteca.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Login (Atendente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"atendente@biblioteca.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Renovar Token (Refresh)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Meus Dados (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Atendentes (Users - Admin)",
      "item": [
        {
          "name": "Listar Atendentes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/user"
          }
        },
        {
          "name": "Criar Atendente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/user",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Atendente\",\n  \"username\": \"joao\",\n  \"email\": \"joao@biblioteca.com\",\n  \"password\": \"123456\",\n  \"isAdmin\": false\n}"
            }
          }
        },
        {
          "name": "Ativar/Desativar Atendente",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/user/2/active",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Categorias",
      "item": [
        {
          "name": "Listar Categorias",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Criar Categoria (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"História\",\n  \"description\": \"Livros de história geral e do Brasil\"\n}"
            }
          }
        },
        {
          "name": "Editar Categoria (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/categories/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tecnologia e Programação\",\n  \"description\": \"Descrição atualizada\"\n}"
            }
          }
        },
        {
          "name": "Excluir Categoria (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/categories/1"
          }
        }
      ]
    },
    {
      "name": "4. Autores",
      "item": [
        {
          "name": "Listar Autores",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/authors"
          }
        },
        {
          "name": "Criar Autor (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/authors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Clarice Lispector\",\n  \"nationality\": \"Brasileira\",\n  \"birthDate\": \"1920-12-10\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Livros",
      "item": [
        {
          "name": "Listar / Buscar Livros com Filtros",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/books?title=&categoryId=&authorId=&available=true"
          }
        },
        {
          "name": "Criar Livro (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Arquitetura Limpa\",\n  \"isbn\": \"978-8550804606\",\n  \"year\": 2019,\n  \"totalCopies\": 3,\n  \"categoryId\": 1,\n  \"authorIds\": [1]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "6. Leitores",
      "item": [
        {
          "name": "Listar Leitores",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/readers"
          }
        },
        {
          "name": "Criar Leitor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/readers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Paula Silva\",\n  \"cpf\": \"111.222.333-44\",\n  \"email\": \"ana@email.com\",\n  \"phone\": \"(44) 99123-4567\"\n}"
            }
          }
        },
        {
          "name": "Histórico de Empréstimos do Leitor",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/readers/1/loans"
          }
        }
      ]
    },
    {
      "name": "7. Empréstimos e Devoluções",
      "item": [
        {
          "name": "Listar Empréstimos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/loans?status="
          }
        },
        {
          "name": "Registrar Empréstimo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/loans",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 1,\n  \"readerId\": 1\n}"
            }
          }
        },
        {
          "name": "Registrar Devolução",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/loans/2/return"
          }
        }
      ]
    },
    {
      "name": "8. Relatórios (Dashboard - Admin)",
      "item": [
        {
          "name": "Dashboard Totais",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/reports/dashboard"
          }
        }
      ]
    }
  ]
}

